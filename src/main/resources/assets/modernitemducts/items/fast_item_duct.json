{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:block_state",
    "block_state_property": "weight",
    "cases": [
      {
        "when": "dense",
        "model": {
          "type": "minecraft:model",
          "model": "modernitemducts:item/fast_item_duct_dense"
        }
      },
      {
        "when": "vacuum",
        "model": {
          "type": "minecraft:model",
          "model": "modernitemducts:item/fast_item_duct_vacuum"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "modernitemducts:item/fast_item_duct"
    }
  }
}
